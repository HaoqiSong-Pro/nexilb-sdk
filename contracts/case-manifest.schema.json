{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nexilb:schema:case-manifest:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "case_id", "model_ids", "contract_state", "objectives", "required_assets", "required_capabilities", "blocking_test_ids", "blocking_validation_ids", "paths", "unresolved_release_bindings"],
  "properties": {
    "$schema": {"const": "urn:nexilb:schema:case-manifest:1.0"},
    "schema_version": {"const": "1.0"},
    "case_id": {"enum": ["CASE-NPHASE-WETTING-MINIMAL", "CASE-IMB-COUPLING-MINIMAL", "CASE-DEM-CONTACT-RESTART", "CASE-PURE-COUPLED-DEGENERATION"]},
    "model_ids": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"enum": ["model.NPhaseContactAngle", "model.NPhaseImbDemContactAngle"]}},
    "contract_state": {"$ref": "#/$defs/state"},
    "objectives": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^objective\\.[a-z0-9_.-]+$"}},
    "required_assets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/missingAsset"}},
    "required_capabilities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/missingCapability"}},
    "blocking_test_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^TST-[A-Z0-9]+(-[A-Z0-9]+)*$"}},
    "blocking_validation_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^VAL-[A-Z0-9]+(-[A-Z0-9]+)*$"}},
    "paths": {
      "type": "object", "additionalProperties": false,
      "required": ["case_config", "acceptance", "reference_manifest", "run_manifest", "verification_result", "media_manifest"],
      "properties": {
        "case_config": {"$ref": "#/$defs/path"}, "acceptance": {"$ref": "#/$defs/path"},
        "reference_manifest": {"$ref": "#/$defs/path"}, "run_manifest": {"$ref": "#/$defs/path"},
        "verification_result": {"$ref": "#/$defs/path"}, "media_manifest": {"$ref": "#/$defs/path"}
      }
    },
    "unresolved_release_bindings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["sdk_version", "api_version", "abi_version", "schema_bundle_version", "runtime_identity", "static_catalog_digest", "effective_catalog_digest", "required_capability_digest", "hardware_matrix_id", "driver_matrix_id", "precision", "unit_system", "integer_time_grid", "determinism_tier", "random_seed", "resource_budget", "approved_input_digests", "approved_manifest_digests", "license_and_publication_rights"]}}
  },
  "allOf": [
    {"if": {"properties": {"case_id": {"const": "CASE-NPHASE-WETTING-MINIMAL"}}, "required": ["case_id"]}, "then": {"properties": {"model_ids": {"const": ["model.NPhaseContactAngle"]}}}},
    {"if": {"properties": {"case_id": {"const": "CASE-IMB-COUPLING-MINIMAL"}}, "required": ["case_id"]}, "then": {"properties": {"model_ids": {"const": ["model.NPhaseImbDemContactAngle"]}}}},
    {"if": {"properties": {"case_id": {"const": "CASE-DEM-CONTACT-RESTART"}}, "required": ["case_id"]}, "then": {"properties": {"model_ids": {"const": ["model.NPhaseImbDemContactAngle"]}}}},
    {"if": {"properties": {"case_id": {"const": "CASE-PURE-COUPLED-DEGENERATION"}}, "required": ["case_id"]}, "then": {"properties": {"model_ids": {"const": ["model.NPhaseContactAngle", "model.NPhaseImbDemContactAngle"]}}}}
  ],
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._/-]+$",
      "allOf": [
        {"not": {"pattern": "^[A-Za-z]:"}},
        {"not": {"pattern": "^/"}},
        {"not": {"pattern": "(^|/)\\.\\.(/|$)"}},
        {"not": {"pattern": "//"}},
        {"not": {"pattern": "(^|/)([Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(\\.|/|$)"}}
      ]
    },
    "state": {"type": "object", "additionalProperties": false, "required": ["implementation", "runtime", "verification"], "properties": {"implementation": {"const": "implementation_not_present"}, "runtime": {"const": "runtime_unavailable"}, "verification": {"const": "verification_not_evaluated"}}},
    "missingAsset": {"type": "object", "additionalProperties": false, "required": ["asset_id", "role", "status"], "properties": {"asset_id": {"type": "string", "pattern": "^asset\\.[a-z0-9_.-]+$"}, "role": {"type": "string", "minLength": 1}, "status": {"const": "required_not_present"}}},
    "missingCapability": {"type": "object", "additionalProperties": false, "required": ["capability_id", "status"], "properties": {"capability_id": {"type": "string", "pattern": "^capability\\.[a-z0-9_.-]+$"}, "status": {"const": "required_unavailable"}}}
  }
}
