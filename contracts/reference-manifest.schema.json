{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "urn:nexilb:schema:reference-manifest:1.0",
  "type": "object", "additionalProperties": false,
  "required": ["$schema", "schema_version", "case_id", "reference_status", "references"],
  "properties": {
    "$schema": {"const": "urn:nexilb:schema:reference-manifest:1.0"}, "schema_version": {"const": "1.0"}, "case_id": {"enum": ["CASE-NPHASE-WETTING-MINIMAL", "CASE-IMB-COUPLING-MINIMAL", "CASE-DEM-CONTACT-RESTART", "CASE-PURE-COUPLED-DEGENERATION"]},
    "reference_status": {"const": "required_not_present"},
    "references": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "role", "status", "required_evidence_ids"], "properties": {"artifact_id": {"type": "string", "pattern": "^reference\\.[a-z0-9_.-]+$"}, "role": {"type": "string", "minLength": 1}, "status": {"const": "required_not_present"}, "required_evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^VAL-[A-Z0-9]+(-[A-Z0-9]+)*$"}}}}}
  }
}
