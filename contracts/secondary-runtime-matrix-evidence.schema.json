{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nexilb:schema:secondary-runtime-matrix-evidence:1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "state", "scope_limit", "execution_count", "records"],
  "properties": {
    "$schema": {"const": "urn:nexilb:schema:secondary-runtime-matrix-evidence:1.0"},
    "schema_version": {"const": "1.0"},
    "state": {"const": "verified_public_secondary_runtime_matrix"},
    "scope_limit": {"const": "API lifecycle and bounded execution only; no physical, convergence or release-acceptance claim"},
    "execution_count": {"const": 16},
    "records": {
      "type": "array", "minItems": 16, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["variant", "dimension", "precision", "case_id", "runtime_sha256", "consumer_sha256", "input_files", "required_completion_markers", "process_exit_code", "state"],
        "properties": {
          "variant": {"enum": ["d2f32", "d2f64", "d3f32", "d3f64"]},
          "dimension": {"enum": [2, 3]},
          "precision": {"enum": ["f32", "f64"]},
          "case_id": {"enum": ["nphase-wetting-minimal", "imb-coupling-minimal", "dem-contact-restart", "pure-coupled-degeneration"]},
          "runtime_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "consumer_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "input_files": {
            "type": "array", "minItems": 1, "maxItems": 2,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["path", "byte_length", "sha256"],
              "properties": {
                "path": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
                "byte_length": {"type": "integer", "minimum": 1},
                "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          },
          "required_completion_markers": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^(RUN|RESTART)-COMPLETED: model=model\\.(NPhaseContactAngle|NPhaseImbDemContactAngle) macro_step=[12]$"}},
          "process_exit_code": {"const": 0},
          "state": {"const": "passed"}
        }
      }
    }
  }
}
